# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wildlife-bot

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=wildlife-bot-media

# JWT Configuration (15-minute access tokens)
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (TODO: Replace with AWS KMS/HSM in production)
FIELD_ENCRYPTION_KEY=demo-key-replace-in-production-32b
AUDIT_HMAC_KEY=your_hmac_secret_key_change_in_production

# Escalation Settings
ESCALATION_THRESHOLD_MINUTES=20

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Voice Integration (Optional - for Twilio Voice webhooks)
VOICE_WEBHOOK_URL=https://your-domain.com/api/transcripts
