# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/wildlife_reports

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AWS S3 Configuration (for media storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=wildlife-reports-media

# Bot Configuration
BOT_NAME=Wildlife Reporter
CASE_TIMEOUT_HOURS=24
HIGH_PRIORITY_RADIUS_KM=10
EXTENDED_RADIUS_KM=25

# Webhook URL (for production ngrok)
WEBHOOK_URL=https://your-domain.com/webhook

# Security
JWT_SECRET=your-jwt-secret-change-in-production
FIELD_ENCRYPTION_KEY=your-encryption-key-32-bytes-long